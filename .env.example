# Environment Configuration Contract
# Grace Arena Resorts - Milestone 1 & Beyond

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp Integration (Format: international code without +)
NEXT_PUBLIC_WHATSAPP_NUMBER=2348123456789

# SendGrid Email Service
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=reservations@gracearenaresorts.com

# Anti-Spam (Google reCAPTCHA v3 or Cloudflare Turnstile - Optional in M1 dev)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Supabase (Optional in M1 mock mode; required for M2)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# Paystack (M2 Booking Engine)
# Paystack signs webhooks with your SECRET KEY: PAYSTACK_WEBHOOK_SECRET must equal PAYSTACK_SECRET_KEY
PAYSTACK_SECRET_KEY=sk_test_placeholder
PAYSTACK_WEBHOOK_SECRET=sk_test_placeholder

# Vercel KV / Upstash REST (shared rate limiting across serverless instances; in-memory fallback if unset)
VERCEL_KV_REST_API_URL=
VERCEL_KV_REST_API_TOKEN=

# Google Analytics 4 (loaded only after the visitor grants analytics consent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Serve bundled mock data from booking/form APIs instead of Supabase (UI previews/tests only; never in production)
NEXT_PUBLIC_USE_MOCK_DATA=false

# Internal jobs (failed-email retries): 16+ random characters; Vercel Cron sends it as a Bearer token
CRON_SECRET=
